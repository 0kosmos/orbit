{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Orbit",
  "version": "0.1.0",
  "identifier": "com.orbitclips.app",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "create": false,
        "title": "Orbit",
        "width": 1000,
        "height": 650,
        "minWidth": 700,
        "minHeight": 450,
        "backgroundColor": "#000000"
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true,
        "scope": ["$APPCACHE/thumbs/**", "$APPCACHE/snip/**", "$VIDEO/Orbit/**"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "0kosmos",
    "homepage": "https://github.com/0kosmos/orbit",
    "copyright": "Copyright (c) 2026 0kosmos",
    "category": "Video",
    "shortDescription": "Lightweight game recorder: screenshots, clips and replays",
    "longDescription": "Orbit is a super lightweight game recording app for Windows: screenshots, region snips, recordings and an instant replay buffer, with almost no performance cost.",
    "resources": {
      "ffmpeg/ffmpeg.exe": "ffmpeg/ffmpeg.exe",
      "ffmpeg/LICENSE.txt": "ffmpeg/LICENSE.txt"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
